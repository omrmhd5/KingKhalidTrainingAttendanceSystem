# Demo sandbox — copy values locally; real secrets live on Vercel/Render/Atlas only.

# Backend (Render)
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/kktas-demo
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/king-khalid-training-attendance-system-demo
MONGO_URI_REMOTE=mongodb+srv://USER:PASS@CLUSTER/kktas-demo
JWT_SECRET=replace-with-a-long-random-demo-secret
FRONTEND_URL=https://king-khalid-training-attendance-system-demo.vercel.app
CORS_ORIGIN=https://king-khalid-training-attendance-system-demo.vercel.app,https://king-khalid-training-attendance-sys.vercel.app,http://localhost:5173
SERVE_FRONTEND=false

# Frontend (Vercel)
# Render hostnames are capped; live API is king-khalid-training-attendance-system.onrender.com
VITE_API_URL=https://king-khalid-training-attendance-system.onrender.com/api
